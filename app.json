{
  "expo": {
    "name": "MATCH",
    "slug": "match",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "match",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#14110E"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.match.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "MATCH usa tu ubicación para mostrarte a qué distancia están otras personas. Tus coordenadas nunca se comparten."
      }
    },
    "android": {
      "package": "com.match.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#14110E"
      },
      "permissions": ["ACCESS_COARSE_LOCATION", "ACCESS_FINE_LOCATION"]
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/notificacion.png",
          "color": "#D99B3C",
          "defaultChannel": "avisos"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "MATCH usa tu ubicación para mostrarte a qué distancia están otras personas. Tus coordenadas nunca se comparten."
        }
      ]
    ],
    "icon": "./assets/icon.png"
  }
}
